#!/bin/bash

# Run linting and formatting checks before push
echo "Running pre-push checks..."
make check

if [ $? -ne 0 ]; then
    echo "ERROR: Code quality check failed. Please run 'make format' and 'make lint' before pushing."
    exit 1
fi

# Also run tests to ensure no regressions are pushed
echo "Running tests..."
make test

if [ $? -ne 0 ]; then
    echo "ERROR: Tests failed. Please fix tests before pushing."
    exit 1
fi

exit 0
